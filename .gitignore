# Dependencias
node_modules/

# Builds del frontend
dist/
dist-ssr/
*.local

# Documentos maquetados para imprimir a PDF: se regeneran con
# `node scripts/make-docs.mjs` a partir de los .md, que son la fuente de
# verdad. Versionarlos duplicaría el contenido y garantizaría que un día se
# queden desfasados.
docs/pdf/
*.pdf

# Documentación y herramientas internas de cómo se construyó el proyecto: son
# material de aprendizaje y notas de trabajo para quien lo hace, no para quien
# lo evalúa desde fuera. Se quedan en el equipo, fuera del repositorio.
CLAUDE.md
docs/DIARIO-APRENDIZAJE.md
docs/PENDIENTES.md
docs/PORTFOLIO.md
docs/LEEME-TESTERS.txt
docs/cvs-ejemplo/
scripts/cvs-ejemplo.mjs
scripts/prueba-en-frio.mjs
scripts/make-docs.mjs
.claude/

# Tauri (Rust) — artefactos de compilación
src-tauri/target/

# Logs y cachés
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/

# Entornos y secretos
.env
.env.*
!.env.example

# Sistema operativo
.DS_Store
Thumbs.db

# Editores
.vscode/*
!.vscode/extensions.json
.idea/

# Base de datos local de desarrollo (datos personales — nunca al repo)
*.sqlite
*.sqlite3
*.db

# Referencias de diseño (capturas + paquetes) — pesan mucho, son docs
assets/references/
*.zip

# Grabaciones de la demo: decenas de MB que inflarían el repo para siempre, y
# su sitio es la web del portfolio (o YouTube), no un commit. Las capturas SÍ
# se versionan (docs/img/): pesan poco y son la portada del README.
assets/video/

# Material de reserva de Olaz (~27 MB): hojas de sprites y frames en crudo de
# los que salieron las animaciones. Se guardan por si hay que regenerarlas,
# pero no son código ni entran en la app.
_zalent_assets_reserva/

# Assets de IA del frontend (~168 MB): modelo de embeddings MiniLM + runtime
# WASM de onnxruntime-web. No se versionan por tamaño; se regeneran con
#   node scripts/fetch-ai-assets.mjs
# (mismo patrón que el sidecar de Ollama en src-tauri/.gitignore). SÍ viajan
# dentro del instalador → app 100% offline desde el primer arranque.
public/ort/
public/models/
public/tesseract/
